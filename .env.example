# ===== 复制为 .env 并填入真实 Key（不要提交 .env 到 Git）=====
# 命令：cp .env.example .env

# --- 大模型（OpenAI 兼容）---
# DeepSeek：https://platform.deepseek.com
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 或者用千问（二选一，改这三行即可）：
# DEEPSEEK_API_KEY=<你的百炼 key>
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# --- 联网搜索（博查）---
# https://open.bocha.cn
BOCHA_API_KEY=

# --- 千问 TTS（DashScope）---
# https://bailian.console.aliyun.com
# 与上面的千问 LLM 共用一个 Key 即可
DASHSCOPE_API_KEY=
